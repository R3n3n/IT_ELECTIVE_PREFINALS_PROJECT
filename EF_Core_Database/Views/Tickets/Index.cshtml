@model IEnumerable<EF_Core_Database.Models.Ticket>

@{
    ViewData["Title"] = "Tickets";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="page-title mb-0">Tickets</h1>
</div>

<div class="table-container table-responsive">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Ticket ID</th>
                <th>Subject</th>
                <th>Customer</th>
                <th>Category</th>
                <th>Priority</th>
                <th>Status</th>
                <th>Created</th>
                <th>Due</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var t in Model)
            {
                <tr>
                    <td>@t.Id</td>
                    <td>@t.Subject</td>
                    <td>@t.Customer.CompanyName</td>
                    <td>@t.Category.Name</td>
                    <td>@t.Priority.Name</td>
                    <td>@t.Status.Name</td>
                    <td>@t.CreatedAt.ToString("g")</td>
                    <td>@(t.DueAt?.ToString("g") ?? "—")</td>
                    <td><a asp-action="Details" asp-route-id="@t.Id" class="loa-button">Details</a></td>
                </tr>
            }
        </tbody>
    </table>
</div>
