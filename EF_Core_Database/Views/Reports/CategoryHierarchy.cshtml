@model IEnumerable<EF_Core_Database.Controllers.CategoryHierarchyViewModel>

@{
    ViewData["Title"] = "Category Hierarchy";
}

<a asp-action="Index"
   class="back-button">
    ← Back to Reports
</a>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="page-title mb-0">Category Hierarchy</h1>
</div>

<div class="table-container table-responsive">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Category</th>
                <th>Parent Category</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in Model)
            {
                <tr>
                    <td>@c.CategoryName</td>
                    <td>@c.ParentCategoryName</td>
                </tr>
            }
        </tbody>
    </table>
</div>
