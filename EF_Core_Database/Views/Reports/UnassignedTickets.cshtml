@model IEnumerable<EF_Core_Database.Controllers.UnassignedTicketViewModel>

@{
    ViewData["Title"] = "Unassigned Tickets";
}

<a asp-action="Index"
   class="back-button">
    ← Back to Reports
</a>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="page-title mb-0">Unassigned Tickets</h1>
</div>

<div class="table-container table-responsive">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Ticket</th>
                <th>Subject</th>
                <th>Customer</th>
                <th>Priority</th>
                <th>Status</th>
                <th>Created At</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var t in Model)
            {
                <tr>
                    <td>@t.TicketId</td>
                    <td>@t.Subject</td>
                    <td>@t.CustomerName</td>
                    <td>@t.PriorityName</td>
                    <td>@t.StatusName</td>
                    <td>@t.CreatedAt</td>
                </tr>
            }
        </tbody>
    </table>
</div>
