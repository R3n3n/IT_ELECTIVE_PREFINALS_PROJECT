@model IEnumerable<EF_Core_Database.Controllers.PrimaryAssigneeViewModel>

@{
    ViewData["Title"] = "Primary Assignee";
}

<a asp-action="Index"
   class="back-button">
    ← Back to Reports
</a>

<h1 class="page-title">Primary Assignee</h1>

<div class="table-container table-responsive">
    <table class="table">
        <thead>
            <tr>
                <th>Ticket</th>
                <th>Subject</th>
                <th>Primary Assignee</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var t in Model)
            {
                <tr>
                    <td>@t.TicketId</td>
                    <td>@t.Subject</td>
                    <td>@t.PrimaryAssignee</td>
                </tr>
            }
        </tbody>
    </table>
</div>